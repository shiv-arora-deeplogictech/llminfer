{
    "timeout": 120000,
    "enableGZIPEncoding": true,
    "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, GET",
        "Access-Control-Allow-Headers": "*",
        "Access-Control-Expose-Headers": "*",
        "Access-Control-Max-Age": 86400
    },
    "host": "{{{hostname}}}",
    "ports": [
        9095
    ],
    "ssl": true,
    "sslKeyFile": "/home/deep/ssh-Certs/sslKeyFile.key",
    "sslCertFile": "/home/deep/ssh-Certs/sslCertFile.crt",
    "ipblacklistRefresh": 5000,
    "ipwhitelistRefresh": 5000,
    "virtualhosts": [
        "{{{hostname}}}:9095"
    ]
}